# Datos pesados (descomentado para rama de entreno)
# data/raw/
# data/processed/

# Python cache
__pycache__/
*.pyc

# Entornos virtuales
venv/
.venv/
source/
.env

# Modelos entrenados: se versionan SOLO los consolidados (best/ + artefactos ONNX
# de produccion) para que el proyecto sea ejecutable sin re-entrenar.
# Se excluyen runs intermedios, archivos de trabajo y backups.
/models/*
!/models/best/
!/models/residual_sac_actor.onnx
!/models/vec_normalize_v5_1M.npz
!/models/best_model.zip
!/models/best_vecnormalize.pkl
logs/
.DS_Store

# Notas personales
anotaciones_para_mi/
doc/memoria_latex/memoria_tipo2.out
doc/memoria_latex/memoria_tipo2.aux
doc/memoria_latex/memoria_tipo2.bbl

# LaTeX: artefactos de compilacion (se regeneran al compilar)
doc/memoria_latex/*.aux
doc/memoria_latex/*.log
doc/memoria_latex/*.out
doc/memoria_latex/*.toc
doc/memoria_latex/*.lof
doc/memoria_latex/*.lot
doc/memoria_latex/*.bbl
doc/memoria_latex/*.blg
doc/memoria_latex/*.acn
doc/memoria_latex/*.glo
doc/memoria_latex/*.ist
doc/memoria_latex/*.acr
doc/memoria_latex/*.alg
doc/memoria_latex/*.gls
doc/memoria_latex/*.glg
doc/memoria_latex/*.bcf
doc/memoria_latex/*.run.xml
doc/memoria_latex/*.fdb_latexmk
doc/memoria_latex/*.fls
texput.log

# Cobertura de tests (pytest-cov)
.coverage
**/.coverage

# Base de datos SQLite del SaaS en modo local (se regenera con seed.py)
*.db

# Modelos importados de otros PC (fuente de extraccion, pesan cientos de MB)
modelos_entrenados_otrosPC/

# Backups temporales de resultados (de la sesion de consolidacion)
resultados/*.bak
resultados/*.pre_reeval*
resultados/*.pre_paso*
resultados/log_sac_puro

# Artefactos de la prueba de instalacion en VM/WSL y ZIP de entrega (no se versionan)
*.zip
lealink/
