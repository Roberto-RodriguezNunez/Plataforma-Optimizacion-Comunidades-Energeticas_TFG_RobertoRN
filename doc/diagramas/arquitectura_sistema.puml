@startuml arquitectura_sistema
!theme plain
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam defaultFontSize 12

title Arquitectura del Sistema SGEC

' ─────────────────────────────────────
'  CAPA DE DATOS
' ─────────────────────────────────────
package "Fuentes de Datos Externas" #LightYellow {
    [ESIOS\n(Perfiles consumo\n2.0TD)] as ESIOS
    [PVGIS\n(Producción FV\n2023)] as PVGIS
    [ESIOS\n(Precios PVPC\n€/MWh)] as PRECIOS
}

package "Almacenamiento Local" #LightBlue {
    database "data/raw/" as RAW {
        [consumo_esios_2023.csv]
        [solar_pvgis_2023.csv]
        [precios_esios_2023.csv]
    }
    database "data/processed/" as PROC {
        [dataset_final.csv\n8760 × 3]
    }
}

' ─────────────────────────────────────
'  CAPA ETL
' ─────────────────────────────────────
package "Pipeline ETL" #LightGreen {
    component "generar_dataset_final.py\n(src/utils/)" as ETL {
        [Desnormalización\nconsumo ESIOS]
        [Perturbación\nestocástica\n15 vecinos]
        [Escalado solar\n× 50 kWp]
        [Conversión\n€/MWh → €/kWh]
    }
}

' ─────────────────────────────────────
'  CAPA DE SIMULACIÓN (GEMELO DIGITAL)
' ─────────────────────────────────────
package "Motor de Simulación (src/core/)" #MistyRose {
    component "ComunidadSimulador" as SIM {
        [Modelo de Batería\n100 kWh / 50 kW]
        [Mapa de Acciones\n13 decisiones macro]
        [Degradación\nno lineal]
        [Contabilidad\neconómica]
    }
}

' ─────────────────────────────────────
'  CAPA DE APRENDIZAJE POR REFUERZO
' ─────────────────────────────────────
package "Entorno RL (src/envs/)" #Lavender {
    component "EnergyEnv\n(gymnasium.Env)" as ENV {
        [Obs: 76 variables\n(4 actuales + 72 forecast)]
        [Acción: Discrete(13)]
        [Reward: cash flow neto]
    }
}

package "Agente DQN" #Thistle {
    component "Entrenamiento\n(Stable Baselines3)" as TRAIN
    component "Modelo entrenado\n(.zip)" as MODEL
}

' ─────────────────────────────────────
'  CAPA DE PRODUCCIÓN
' ─────────────────────────────────────
package "Despliegue Edge" #LightCyan {
    component "Exportación ONNX\n(.onnx)" as ONNX
    node "Contenedor Docker" as DOCKER {
        component "Inferencia\n(onnxruntime + numpy)" as INFER
    }
    node "Raspberry Pi 4/5" as RPI {
        [Controlador\nde Borde]
    }
}

' ─────────────────────────────────────
'  RELACIONES
' ─────────────────────────────────────
ESIOS  --> RAW
PVGIS  --> RAW
PRECIOS --> RAW

RAW --> ETL
ETL --> PROC

PROC --> SIM : "Lee dataset_final.csv"

SIM --> ENV : "ejecutar_accion_fisica()\nget_data_window()"
ENV --> TRAIN : "obs, reward, done"
TRAIN --> MODEL : "guarda mejor modelo"

MODEL --> ONNX : "exportar"
ONNX --> DOCKER
DOCKER --> RPI : "inferencia ligera"

@enduml
