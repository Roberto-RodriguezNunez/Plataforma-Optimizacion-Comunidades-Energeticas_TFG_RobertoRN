@startuml casos_de_uso
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam actorStyle awesome

left to right direction

title Diagrama de Casos de Uso — SGEC

' ─── ACTORES ───────────────────────────────────
actor "Administrador" as ADMIN
actor "Vecino" as VECINO
actor "Red Eléctrica\n(ESIOS)" as RED #LightYellow
actor "Sistema DQN\n(Agente IA)" as DQN #LightBlue

' ─── SISTEMA ────────────────────────────────────
rectangle "Sistema de Gestión Energética Comunitaria (SGEC)" {

    ' Administrador
    usecase "Ejecutar pipeline ETL\n(generar dataset)" as UC1
    usecase "Iniciar entrenamiento\ndel agente DQN" as UC2
    usecase "Evaluar rendimiento\ndel agente" as UC3
    usecase "Exportar modelo\na ONNX" as UC4
    usecase "Desplegar sistema\nen Docker/Edge" as UC5
    usecase "Configurar parámetros\nfísicos de la batería" as UC6

    ' Vecino
    usecase "Consultar ahorro\nenergético acumulado" as UC7
    usecase "Consultar estado\nde la batería (SoC)" as UC8

    ' Sistema DQN (actor automatizado)
    usecase "Observar estado\ndel sistema (76 vars)" as UC9
    usecase "Seleccionar acción\nmacro (0-12)" as UC10
    usecase "Aplicar acción\nen simulador físico" as UC11
    usecase "Recibir recompensa\n(cash flow neto)" as UC12

    ' Red Eléctrica
    usecase "Proporcionar datos\nde precios y consumo" as UC13
}

' ─── RELACIONES ACTOR → CASO DE USO ─────────────
ADMIN --> UC1
ADMIN --> UC2
ADMIN --> UC3
ADMIN --> UC4
ADMIN --> UC5
ADMIN --> UC6

VECINO --> UC7
VECINO --> UC8

DQN --> UC9
DQN --> UC10
DQN --> UC11
DQN --> UC12

RED --> UC13

' ─── RELACIONES <<include>> / <<extend>> ─────────
UC2 ..> UC1 : <<include>>
UC4 ..> UC2 : <<include>>
UC5 ..> UC4 : <<include>>

UC10 ..> UC9  : <<include>>
UC11 ..> UC10 : <<include>>
UC12 ..> UC11 : <<include>>

UC3 ..> UC7 : <<extend>>

@enduml
