@startuml casos_de_uso
!theme plain
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam actorStyle awesome
skinparam linetype polyline
skinparam ArrowColor #333333
skinparam usecaseBorderColor #555555

!pragma layout smetana
left to right direction

title Diagrama de Casos de Uso — SGEC

actor "Administrador"          as ADMIN  #LightGray
actor "Red Eléctrica\n(ESIOS)" as RED    #LightYellow

rectangle "Sistema de Gestión Energética Comunitaria (SGEC)" {
    usecase "Proporcionar datos\nde consumo y precios"   as UC1
    usecase "Ejecutar pipeline ETL"                      as UC2
    usecase "Entrenar agente DQN"                        as UC3
    usecase "Exportar y desplegar\nmodelo (ONNX / Edge)" as UC4
    usecase "Configurar batería\ny comunidad"            as UC5
    usecase "Ejecutar inferencia\nen tiempo real"        as UC6
    usecase "Gestionar carga/descarga\nbatería"          as UC7
    usecase "Consultar métricas\nglobales"               as UC8
    usecase "Consultar ahorro\nindividual"               as UC9

}

actor "Sistema Edge\n(Automático)" as EDGE   #LightGreen
actor "Vecino"                     as VECINO #FFE6CC

RED    --> UC1
ADMIN  --> UC2
ADMIN  --> UC3
ADMIN  --> UC4
ADMIN  --> UC5
ADMIN  --> UC8
ADMIN  --> UC9
EDGE   --> UC6
VECINO --> UC8
VECINO --> UC9

UC6 ..> UC7 : <<include>>

@enduml
